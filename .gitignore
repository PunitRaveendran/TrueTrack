# Large archive files (extracted directories are tracked directly)
*.zip

# Local nested clone of this repository (never commit)
TrueTrack/

# Keep the navigation foreground service visible to Git
!android_app/app/src/main/java/com/truetrack/
!android_app/app/src/main/java/com/truetrack/navigation/
!android_app/app/src/main/java/com/truetrack/navigation/NavigationForegroundService.kt


.chrome_tmp/
.preview_cockpit.png
# Keep vendored MapLibre runtime tracked despite the generic `lib/` rule.
!web_app/lib/
!web_app/lib/maplibre-gl.js
!web_app/lib/maplibre-gl.css
!web_app/lib/LICENSE.txt

