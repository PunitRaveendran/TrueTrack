<?xml version="1.0" encoding="utf-8"?>
<!--
    TrueTrack v2.1 — Full-screen navigation layout
    Layer stack (bottom → top):
      1. MapView         (full screen base)
      2. Search card     (top floating — AutoComplete + Theme toggle)
      3. Status badge    (top-left below search)
      4. Bottom HUD      (speed + IMU + controls)
      5. Playback bar    (inside HUD, shown for routes)
      6. Legend chip     (bottom-left)
      7. Recenter FAB    (bottom-right)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 1: Full-screen OpenStreetMap                    -->
    <!-- ══════════════════════════════════════════════════════ -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#090D16" />

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 2: Floating Search Card                         -->
    <!-- ══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="10dp"
        android:elevation="16dp"
        app:cardBackgroundColor="#E6060A12"
        app:cardCornerRadius="18dp"
        app:cardElevation="12dp"
        app:strokeColor="#1E2D42"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="14dp">

            <!-- Header: TrueTrack label + Dark/Light toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="TRUETRACK"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnImuCalibration"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#0F172A"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="8dp"
                    android:text="IMU CAL"
                    android:textColor="#38BDF8"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:backgroundTint="#0F172A"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:text="🌙  DARK"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Origin row (AutoCompleteTextView for suggestions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_green" />

                <AutoCompleteTextView
                    android:id="@+id/etOrigin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:completionHint=""
                    android:dropDownVerticalOffset="2dp"
                    android:fontFamily="sans-serif"
                    android:hint="Point A — Where from?"
                    android:imeOptions="actionNext"
                    android:inputType="textPostalAddress"
                    android:singleLine="true"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#3D5068"
                    android:textSize="14sp"
                    android:completionThreshold="3" />

                <ImageButton
                    android:id="@+id/btnClearOrigin"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@null"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#3D5068"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Swap divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="22dp"
                    android:layout_weight="1"
                    android:background="#1A2E44" />

                <ImageButton
                    android:id="@+id/btnSwap"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_map_hud_chip"
                    android:contentDescription="Swap A and B"
                    android:padding="5dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="#64748B" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1A2E44" />
            </LinearLayout>

            <!-- Destination row (AutoCompleteTextView for suggestions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_red" />

                <AutoCompleteTextView
                    android:id="@+id/etDestination"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:completionHint=""
                    android:dropDownVerticalOffset="2dp"
                    android:fontFamily="sans-serif"
                    android:hint="Point B — Where to?"
                    android:imeOptions="actionDone"
                    android:inputType="textPostalAddress"
                    android:singleLine="true"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#3D5068"
                    android:textSize="14sp"
                    android:completionThreshold="3" />

                <ImageButton
                    android:id="@+id/btnClearDest"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@null"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#3D5068"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Navigate Button -->
            <Button
                android:id="@+id/btnNavigate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#0EA5E9"
                android:fontFamily="monospace"
                android:letterSpacing="0.07"
                android:text="▶  NAVIGATE"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 3: Status Badge (floating, top-left)            -->
    <!-- ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/badgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="240dp"
        android:background="@drawable/bg_map_hud_chip"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:visibility="gone">

        <View
            android:id="@+id/dotStatus"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="READY"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 4: Bottom HUD                                   -->
    <!-- ══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:elevation="16dp"
        app:cardBackgroundColor="#E6060A12"
        app:cardCornerRadius="18dp"
        app:cardElevation="12dp"
        app:strokeColor="#1E2D42"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingHorizontal="14dp">

            <!-- Speed + IMU row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="0.0"
                        android:textColor="#00E5FF"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="km/h"
                        android:textColor="#334155"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="#1E293B" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRouteInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Enter A → B to navigate"
                        android:textColor="#64748B"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvImu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="IMU: —"
                        android:textColor="#334155"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Playback Seekbar (hidden until route loaded) -->
            <LinearLayout
                android:id="@+id/layoutPlayback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_map_hud_chip"
                    android:contentDescription="Play or pause simulation"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_media_pause" />

                <SeekBar
                    android:id="@+id/seekPlayback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:progressTint="#0EA5E9"
                    android:thumbTint="#00E5FF" />

                <TextView
                    android:id="@+id/tvPlaybackTime"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0:00"
                    android:textColor="#475569"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnKillGps"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7F1D1D"
                    android:fontFamily="monospace"
                    android:text="⚡  KILL GPS"
                    android:textColor="#FCA5A5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDemoRoutes"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0F172A"
                    android:fontFamily="monospace"
                    android:text="📂  DEMO ROUTES"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnParty"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1D4ED8"
                    android:fontFamily="monospace"
                    android:text="PARTY"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 5: Map Legend (bottom-left, above HUD)          -->
    <!-- ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutLegend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="155dp"
        android:background="@drawable/bg_map_hud_chip"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <View android:layout_width="12dp" android:layout_height="3dp" android:background="#94A3B8" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" Plan " android:textColor="#94A3B8" android:textSize="8sp" android:fontFamily="monospace" />

        <View android:layout_width="12dp" android:layout_height="3dp" android:background="#00E5FF" android:layout_marginStart="6dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" TT " android:textColor="#E2E8F0" android:textSize="8sp" android:fontFamily="monospace" />

        <View android:layout_width="12dp" android:layout_height="3dp" android:background="#EF4444" android:layout_marginStart="6dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" IMU" android:textColor="#94A3B8" android:textSize="8sp" android:fontFamily="monospace" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 6: Recenter FAB (bottom-right, above HUD)       -->
    <!-- ══════════════════════════════════════════════════════ -->
    <ImageButton
        android:id="@+id/btnRecenter"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="155dp"
        android:background="@drawable/bg_recenter_button"
        android:contentDescription="Re-center map on vehicle"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_recenter" />

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 7: Diagnostics FAB (bottom-right, above recenter) -->
    <!-- ══════════════════════════════════════════════════════ -->
    <ImageButton
        android:id="@+id/btnDiagnostics"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="210dp"
        android:background="@drawable/bg_recenter_button"
        android:contentDescription="Toggle live diagnostics overlay"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_gauge" />

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 8: Collapsible Diagnostics Overlay Panel         -->
    <!-- ══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="75dp"
        android:layout_marginHorizontal="10dp"
        android:elevation="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F2080E1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp"
        app:strokeColor="#1E3A5F"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Title & Close row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="FLIGHT RECORDER · LIVE NPU"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseDiagnostics"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@null"
                    android:contentDescription="Close diagnostics"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#94A3B8" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#1E293B" />

            <!-- Row 1: Visual Lean Gauge & Acceleration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Rotating Artificial Horizon Needle in Dial -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_tilt_gauge">

                    <ImageView
                        android:id="@+id/viewLeanNeedle"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:src="@drawable/needle_tilt" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDiagLean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="LEAN: 0.0° (LEVEL)"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDiagAccel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="|a|: 1.00 G · 9.81 m/s²"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDiagKinematics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="SPEED: 0.0 km/h · HDG: 0°"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#1E293B" />

            <!-- Row 2: NPU Latency & Calibrated Gyro Bias -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="HEXAGON NNAPI NPU"
                        android:textColor="#64748B"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvDiagNpu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="LATENCY: 1.2 ms"
                        android:textColor="#4ADE80"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="ROUTE GYRO BIAS"
                        android:textColor="#64748B"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvDiagGyroBias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="BIAS: +0.0000 rad/s"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#1E293B" />

            <!-- Row 3: Blackout Status & Running INS Drift -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="GPS LOCK STATUS"
                        android:textColor="#64748B"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvDiagGpsStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="LOCK: NOMINAL"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="UNASSISTED INS DRIFT"
                        android:textColor="#64748B"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvDiagDrift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
