<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:padding="12dp">

    <!-- Top Instrument Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRUETRACK"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvNpuBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="ONNX: N/A"
                android:textSize="10sp"
                android:textColor="@color/accent_blue"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- GNSS Status Banner -->
        <LinearLayout
            android:id="@+id/statusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_menu_compass"
                android:backgroundTint="@color/status_green" />

            <TextView
                android:id="@+id/tvGpsStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="GNSS LOCKED (50 Hz SENSOR/SIM)"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvBlackoutTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hero Speed & Lean Angle Card -->
    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/bg_surface"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Speed Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORWARD SPEED"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="41.2"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_subtle" />

        <!-- Lean Angle Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROLL LEAN φ(t)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLeanAngle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18.4°"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/alert_amber"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLeanDirection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIGHT LEAN (R_x De-rolled)"
                android:textColor="@color/alert_amber"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secondary Telemetry Grid -->
    <LinearLayout
        android:id="@+id/gridMetrics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/heroCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YAW RATE (ω_z)"
                android:textSize="9sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvYawRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.2 °/s"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LATERAL CONSTRAINT"
                android:textSize="9sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvLateralConstraint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IRC:86 (≤1.8m)"
                android:textSize="14sp"
                android:textColor="@color/status_green"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRIDGE"
                android:textSize="9sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":8765"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Embedded High-Tech OSM Navigation Map Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#253248"
        app:cardBackgroundColor="#0B0F17"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/gridMetrics"
        app:layout_constraintBottom_toTopOf="@id/tvRawImu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- OpenStreetMap MapView -->
            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#090D16" />

            <!-- Floating Top-Left HUD Badge -->
            <LinearLayout
                android:id="@+id/badgeMapMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_map_hud_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/mapModeDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/ic_menu_compass"
                    android:backgroundTint="@color/status_green" />

                <TextView
                    android:id="@+id/tvMapStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="LIVE NEURAL TRAJECTORY"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Floating Bottom-Left Map Legend -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_map_hud_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="14dp"
                    android:layout_height="4dp"
                    android:background="@color/accent_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="TrueTrack"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:background="@color/alert_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Naive Drift"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Floating Recenter FAB -->
            <ImageButton
                android:id="@+id/btnRecenter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_recenter_button"
                android:src="@drawable/ic_recenter"
                android:contentDescription="Recenter vehicle on map"
                android:padding="8dp" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Raw 3D Diagnostics Line -->
    <TextView
        android:id="@+id/tvRawImu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@color/bg_surface"
        android:padding="8dp"
        android:text="3D ACCEL: ax=0.00 ay=0.00 az=9.81 m/s² | |g|=9.81 (1.00G)"
        android:textColor="@color/text_secondary"
        android:textSize="9.5sp"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Control Actions & Stage Demo Failover Button -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnKillGps"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:backgroundTint="@color/alert_red"
            android:text="KILL GPS FIX (SIMULATE BLACKOUT)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDemoMode"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/bg_card"
                android:text="CORRIDOR: LIVE"
                android:textColor="@color/accent_blue"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnToggleVoice"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.9"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/bg_card"
                android:text="AUDIO: ON"
                android:textColor="@color/accent_blue"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnToggleLeanCorrection"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_card"
                android:text="LEAN NHC: ON"
                android:textColor="@color/status_green"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
