<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:padding="16dp">

    <!-- Top Instrument Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRUETRACK"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvNpuBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="HEXAGON NPU 1.4ms"
                android:textSize="11sp"
                android:textColor="@color/accent_blue"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- GNSS Status Banner -->
        <LinearLayout
            android:id="@+id/statusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/status_dot"
                android:backgroundTint="@color/status_green" />

            <TextView
                android:id="@+id/tvGpsStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="GNSS LOCKED (50 Hz SIM/SENSOR)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvBlackoutTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hero Speed & Lean Angle Card -->
    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/bg_surface"
        android:padding="20dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Speed Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORWARD SPEED"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="41.2"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_subtle" />

        <!-- Lean Angle Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROLL LEAN φ(t)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLeanAngle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18.4°"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="@color/alert_amber"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLeanDirection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIGHT LEAN (R_x De-rolled)"
                android:textColor="@color/alert_amber"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secondary Telemetry Grid -->
    <GridLayout
        android:id="@+id/gridMetrics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintTop_toBottomOf="@id/heroCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginEnd="8dp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:orientation="vertical">
            <TextView
                android:text="YAW RATE (ω_z)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvYawRate"
                android:text="4.2 °/s"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginStart="8dp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:orientation="vertical">
            <TextView
                android:text="LATERAL CONSTRAINT"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvLateralConstraint"
                android:text="IRC:86 (≤1.8m)"
                android:textSize="18sp"
                android:textColor="@color/status_green"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:orientation="vertical">
            <TextView
                android:text="DRIFT RATE"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvDriftRate"
                android:text="0.008 m/s"
                android:textSize="18sp"
                android:textColor="@color/accent_blue"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:orientation="vertical">
            <TextView
                android:text="DUAL-SCREEN BRIDGE"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvServerStatus"
                android:text="ws://*:8765"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace" />
        </LinearLayout>
    </GridLayout>

    <!-- Raw Diagnostics Line -->
    <TextView
        android:id="@+id/tvRawImu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/bg_surface"
        android:padding="10dp"
        android:text="IMU 50Hz: ax=0.12 ay_derolled=-0.04 az=9.81 | gx=0.01 gz=0.07"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/gridMetrics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Control Actions & Stage Demo Failover Button -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnKillGps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/alert_red"
            android:text="KILL GPS FIX (SIMULATE BLACKOUT)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleVoice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/bg_card"
                android:text="AUDIO: ON"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnToggleLeanCorrection"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/bg_card"
                android:text="LEAN NHC: ACTIVE"
                android:textColor="@color/status_green"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
